# ---------------------------------------------------------------------------
# Master environment template for MODEZA boutique.
#
# This file is documentation only. Copy secrets to your hosting dashboard —
# never commit real values. Backend runs on Render (Django), frontend on Vercel
# (static Vite SPA). See README.md for the deployment runbook.
# ---------------------------------------------------------------------------

# ---- Django backend (Render "Web Service" env) ---------------------------
DJANGO_SECRET_KEY="generate-with-openssl-rand-base64-32"
DJANGO_DEBUG="False"
# Set to your app host, e.g. "boutique-backend.onrender.com" ("" or "*" while bootstrapping)
DJANGO_ALLOWED_HOSTS="boutique-backend.onrender.com"
DJANGO_SESSION_COOKIE_SECURE="True"
DJANGO_CSRF_COOKIE_SECURE="True"
# Enable only if TLS terminates on Render with HTTP_X_FORWARDED_PROTO https.
DJANGO_SECURE_SSL_REDIRECT="True"

# Should exactly match the Vercel frontend origin, e.g. https://yourapp.vercel.app
FRONTEND_ORIGIN="https://yourapp.vercel.app"

# Render managed Postgres connection string:
# postgres://user:password@host:port/dbname?sslmode=require
DATABASE_URL="postgres://USER:PASSWORD@HOST:5432/DBNAME?sslmode=require"

# Supabase auth — the JWT secret, issuer, audience used to verify Supabase tokens.
SUPABASE_JWT_SECRET="fe_match_issued_jwt_secret_without_the_trailing_="
SUPABASE_JWT_ISSUER="https://ngpzjddvkgopfmghjqnv.supabase.co/auth/v1"
SUPABASE_JWT_AUDIENCE="authenticated"

# Payment / webhook security — generate long random values.
PAYMENT_WEBHOOK_SECRET="replace-with-a-long-random-secret"
MPESA_CALLBACK_SECRET="replace-with-a-long-random-secret"
MPESA_ENV="sandbox"
MPESA_CONSUMER_KEY="your-daraja-consumer-key"
MPESA_CONSUMER_SECRET="your-daraja-consumer-secret"
MPESA_SHORTCODE="your-daraja-shortcode"
MPESA_PASSKEY="your-daraja-passkey"
# Must be publicly reachable (your Render backend):
MPESA_CALLBACK_URL="https://boutique-backend.onrender.com/api/payments/mpesa/callback"

# Store branding used on automatic receipt PDFs and emails.
STORE_NAME="MODEZA Boutique"
STORE_EMAIL="boutique.modeza.support@gmail.com"
STORE_PHONE="+254 719 770 185"
STORE_WEBSITE="https://atlier-boutique.vercel.app/"
STORE_ADDRESS="Nairobi, Kenya"

# Outbound email (automatic receipts). Leave EMAIL_HOST empty for the console
# backend (development/safe default). Set once you have SMTP credentials.
EMAIL_HOST="smtp.gmail.com"
EMAIL_PORT="587"
EMAIL_HOST_USER="boutique.modeza.support@gmail.com"
EMAIL_HOST_PASSWORD="YOUR_GOOGLE_APP_PASSWORD"
EMAIL_USE_TLS="True"
EMAIL_USE_SSL="False"

DEFAULT_FROM_EMAIL="MODEZA Boutique <receipts@modeza.co.ke>"
SERVER_EMAIL="boutique.modeza.support@gmail.com"

# ---- Background work: Celery + Redis (see backend/docs/CELERY.md) ----------
# Render: leave REDIS_URL empty on the free plan — no worker can run there and
# everything executes inline in the web process. Link a Render Redis resource
# and REDIS_URL is injected automatically.
REDIS_URL="redis://localhost:6379/0"
# Single switch for both bulk imports and email delivery:
#   false -> browser-driven /process loop + inline email after DB commit.
#   true  -> both handed to a Celery worker through Redis (requires a worker).
CELERY_WORKER_ENABLED="False"
# Safety net: when no worker can drain the broker, .delay() runs the task
# inline instead of stranding it. Set explicitly only to override.
CELERY_TASK_ALWAYS_EAGER="True"
# Must exceed the longest task (bulk imports are capped at 2h) or Redis will
# redeliver a still-running job to a second worker.
CELERY_VISIBILITY_TIMEOUT="7500"
CELERY_TASK_TIME_LIMIT="3600"

# ---- Frontend (Vercel project env, VITE_* are baked at build time) -------
# Point at the deployed Django API on Render.
VITE_API_BASE_URL="https://boutique-backend.onrender.com"
VITE_ADMIN_URL="https://boutique-backend.onrender.com/admin/dashboard/"
VITE_SUPABASE_URL="https://ngpzjddvkgopfmghjqnv.supabase.co"
VITE_SUPABASE_ANON_KEY="sb_publishable_..."  # public publishable key only

# ---- Local development only (Node/Express dev server) --------------------
PORT="3000"
ADMIN_API_TOKEN=""